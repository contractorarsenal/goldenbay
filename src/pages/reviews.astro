---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
---
<Base title="Reviews" description="Homeowner reviews of Golden Bay Builders in San Jose, CA." path="/reviews/" noindex crumbs={[{ name: 'Home', path: '/' }, { name: 'Reviews', path: '/reviews/' }]}>
  <PageHero eyebrow="Reviews" title="Homeowner reviews." lede="Reviews will be published here with each client’s permission and accurate attribution." crumbs={[{ name: 'Home', href: '/' }]} />
  <section class="section"><div class="wrap prose"><p>We are collecting permissioned testimonials and links to independent review profiles. We do not publish unattributed or invented reviews.</p><p>If you have worked with us and want to share your experience, please <a href="/contact/">get in touch</a>.</p></div></section>
  <Cta />
</Base>
