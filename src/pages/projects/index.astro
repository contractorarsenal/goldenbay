---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Cta from '../../components/Cta.astro';
import { services } from '../../data/services';
import { projects } from '../../data/projects';
const hasProjects = projects.length > 0;
---
<Base title="Projects" description="Residential remodeling, addition and ADU projects by Golden Bay Builders in San Jose, CA." path="/projects/" noindex={!hasProjects} crumbs={[{ name: 'Home', path: '/' }, { name: 'Projects', path: '/projects/' }]}>
  <PageHero eyebrow="Projects" title="Completed work, shown honestly." lede={hasProjects ? 'Selected projects with scope and photography.' : 'Our project gallery is being assembled from real, approved photography. We do not use stock images to represent our work.'} crumbs={[{ name: 'Home', href: '/' }]} />
  <section class="section"><div class="wrap">
    {hasProjects ? (
      <div style="display:grid;gap:3rem;grid-template-columns:repeat(auto-fill,minmax(20rem,1fr))">
        {projects.map((p) => <a href={`/projects/${p.slug}/`} style="text-decoration:none"><img src={p.hero.src} alt={p.hero.alt} width={p.hero.width} height={p.hero.height} loading="lazy" style="width:100%;height:auto" /><span class="eyebrow" style="margin-top:1rem">{p.category}</span><h3>{p.title}</h3><p>{p.summary}</p></a>)}
      </div>
    ) : (
      <div class="split rev">
        <div>
          <span class="eyebrow">Every case study will include</span>
          <ol class="rule-list" style="margin-top:1.5rem;list-style:none">
            {[['Scope of work', 'What was built or changed, in plain terms.'], ['The challenge', 'Site, structure or planning problems and how they were solved.'], ['Photography', 'Real photos of the finished work, with before-and-after where available.'], ['Related services', 'Links to the service and guides most relevant to the project.']].map(([t, d], i) => <li style="grid-template-columns:3rem 1fr"><span class="num">0{i + 1}</span><div><h3 style="font-size:1.3rem">{t}</h3><p style="color:var(--color-muted)">{d}</p></div></li>)}
          </ol>
        </div>
        <div class="prose"><h2 style="margin-top:0">Planning something similar?</h2><p>Projects will be added as photography and homeowner approvals come in. Until then, the service pages explain how each kind of project works.</p><ul>{services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}</ul><p><a href="/contact/">Ask about work similar to yours</a></p></div>
      </div>
    )}
  </div></section>
  <Cta />
</Base>
