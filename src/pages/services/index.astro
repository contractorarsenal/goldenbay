---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Cta from '../../components/Cta.astro';
import { services } from '../../data/services';
---
<Base title="Residential Construction Services in San Jose" description="Full home remodeling, home additions, ADU construction, kitchen and bathroom remodeling, and custom homes from Gold Bay Builders in San Jose, CA." path="/services/" crumbs={[{ name: 'Home', path: '/' }, { name: 'Services', path: '/services/' }]}>
  <PageHero eyebrow="Services" title="What we build for San Jose homeowners." lede="Six services covering most residential projects, from a single bathroom to a new home." crumbs={[{ name: 'Home', href: '/' }]} />
  <section class="section"><div class="wrap">
    {services.map((s) => <a class="svc-row" href={`/services/${s.slug}/`}><span class="num">{s.num}</span><h3>{s.name}</h3><p>{s.short}</p><span class="go" aria-hidden="true">→</span></a>)}
    <div style="border-top:1px solid var(--color-stone-2)"></div>
  </div></section>
  <Cta />
</Base>
