---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import { processSteps } from '../data/process';
---
<Base closingCta title="How a Residential Project Usually Unfolds" description="General guidance on how a residential remodel, addition, ADU or custom home usually proceeds in San Jose, from first conversation to final review." path="/our-process/" crumbs={[{ name: 'Home', path: '/' }, { name: 'Our Process', path: '/our-process/' }]}>
  <PageHero eyebrow="Our process" title="How a residential project usually unfolds." lede="General guidance, not a commitment. The written agreement for each project sets its timeline, sequence and terms, and city review timing is set by the city." crumbs={[{ name: 'Home', href: '/' }]} />
  <section class="v8-section">
    <div class="wrap">
      <ol class="svp-list">
        {processSteps.map((p) => (
          <li><span class="sv-num">Step {p.n}</span><h3>{p.title}</h3><p>{p.text}</p></li>
        ))}
      </ol>
    </div>
  </section>
  <Cta />
</Base>
