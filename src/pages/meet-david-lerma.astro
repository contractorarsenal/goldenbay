---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import { business } from '../data/business';
// Stays noindex until David approves a fuller biography. No portrait is shown until one is supplied.
---
<Base title="Meet David Lerma" description="David Lerma is the owner of Gold Bay Builders Inc., a San Jose residential contractor." path="/meet-david-lerma/" noindex crumbs={[{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }, { name: 'Meet David Lerma', path: '/meet-david-lerma/' }]}>
  <PageHero eyebrow="The owner" title="David Lerma" lede={`Owner, ${business.name}`} crumbs={[{ name: 'Home', href: '/' }, { name: 'About', href: '/about/' }]} />
  <section class="v8-section">
    <div class="wrap v8-split">
      <div class="v8-prose">
        <p class="lede">David owns Gold Bay Builders Inc. and is the main point of contact for homeowners.</p>
        <p>To talk through a project with David, call the office or send an estimate request. You can also read how the company works with homeowners on the <a class="v8-link" href="/about/">About page</a>.</p>
      </div>
      <div class="v8-panel">
        <h2 style="font-size:1.6rem">Start a conversation</h2>
        <p>Share the basics about your home and what you want to change, or call to speak with David directly.</p>
        <div class="v8-actions" style="margin-top:1.5rem">
          <a class="btn btn-primary" href="/request-estimate/" data-track="request_estimate_click">Request an Estimate</a>
          <a class="btn btn-line" href={business.phoneHref} data-track="click_to_call">Call Now</a>
        </div>
      </div>
    </div>
  </section>
  <Cta />
</Base>
