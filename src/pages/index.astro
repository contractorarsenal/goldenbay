---
import Base from '../layouts/Base.astro';
import ProjectImage from '../components/ProjectImage.astro';
import Testimonial from '../components/Testimonial.astro';
import { business } from '../data/business';
import { heroPhoto } from '../data/home';
import { getProject } from '../data/projects';
import { getReview } from '../data/reviews';

const hero = getProject(heroPhoto.slug).images[heroPhoto.i];

// Homeowner problems: concerns with one practical question each. No guarantees.
const problems = [
  { title: 'Unclear scope', text: 'Projects drift when the scope is only discussed, not written down.' },
  { title: 'Budget surprises', text: 'Costs climb when allowances are vague and changes are priced later.' },
  { title: 'Poor communication', text: 'Long silences between visits leave homeowners guessing what happens next.' },
  { title: 'Messy job sites', text: 'Dust and debris spread through a home when the work area is not contained.' },
];

// Services. The two feature cards use real photographs; the rest are text cards (no empty image frames).
const kitchenPhotos = [getProject('kitchen-remodel').images[0], getProject('bathroom-stone-shower-terracotta-floor').images[0]];
const services = [
  { key: 'kb', feature: true, title: 'Kitchen & Bathroom Remodeling', text: 'Rooms rebuilt around daily use, with the planning, waterproofing and trades behind the finish.', scope: ['Layout, storage and lighting', 'Waterproofing and ventilation', 'Cabinetry, tile and fixtures'], links: [{ label: 'Kitchen remodeling', href: '/services/kitchen-remodeling/' }, { label: 'Bathroom remodeling', href: '/services/bathroom-remodeling/' }] },
  { key: 'fh', feature: false, title: 'Full Home Remodeling', text: 'Whole-house renovations that rework layout, systems and finishes under one scope.', scope: ['Opening and reconfiguring floor plans', 'Updating older electrical and plumbing', 'Coordinated finishes, room to room'], links: [{ label: 'Full home remodeling', href: '/services/full-home-remodeling/' }] },
  { key: 'ad', feature: false, title: 'Home Additions', text: 'Added rooms and second stories that tie into the structure and style of the house you have.', scope: ['Primary suites and family rooms', 'Second-story additions', 'Roof, framing and systems tie-ins'], links: [{ label: 'Home additions', href: '/services/home-additions/' }] },
  { key: 'adu', feature: false, title: 'ADU Construction', text: 'Detached, attached and garage-conversion accessory dwelling units.', scope: ['Detached and attached units', 'Garage conversions', 'San José permitting context'], links: [{ label: 'ADU construction', href: '/services/adu-construction/' }, { label: 'San Jose ADU guide', href: '/guides/san-jose-adu-guide/' }] },
  { key: 'cu', feature: false, title: 'Custom Home Building', text: 'New homes planned from the site up, built from your architect’s or designer’s plans.', scope: ['Site and feasibility review', 'Builder input before plans are final', 'Staged inspections to final'], links: [{ label: 'Custom home building', href: '/services/custom-home-construction/' }] },
];

// Projects: three real photographs, one per project, no bathroom repeated.
const work = [
  { slug: 'kitchen-remodel', focus: '50% 52%' },
  { slug: 'bathroom-stone-shower-terracotta-floor', focus: '50% 45%' },
  { slug: 'patio-construction', focus: '50% 68%' },
].map((f) => { const p = getProject(f.slug); return { ...f, p, img: p.images[0] }; });

// Reviews: exact supplied text.
const lead = getReview('terri-m');
const pairA = getReview('andrea-j');
const pairB = getReview('kevin-j');

// Process: four general steps. Not confirmed operating commitments.
const steps = [
  { t: 'Tell us about the project', x: 'Share what you want to change, the property and a budget range.' },
  { t: 'Site review and scope', x: 'We look at the property and write down what is and is not included.' },
  { t: 'Estimate and agreement', x: 'You receive a written estimate to compare, and terms are settled before work begins.' },
  { t: 'Planning, build and closeout', x: 'Selections, permits, construction and a final walk-through, with decisions raised before they delay work.' },
];
---
<Base
  title="Gold Bay Builders | Home Remodeling & Construction in San Jose, CA"
  description="Gold Bay Builders is a San Jose residential contractor for full home remodels, additions, ADUs, kitchen and bathroom remodeling and custom builds. Request an estimate."
  path="/"
  overlayHeader
>
  <!-- 2 · HERO -->
  <section class="hp-hero on-dark" aria-labelledby="hero-title">
    <div class="hp-hero-bg">
      <ProjectImage file={hero.file} alt="" focus={hero.focus} aspect="4 / 5" mobileAspect="4 / 5" mobileFocus="60% 56%" sizes="100vw" priority />
    </div>
    <div class="wrap hp-hero-inner">
      <span class="eyebrow">San Jose home remodeling &amp; construction</span>
      <h1 id="hero-title">Built for the way you live.</h1>
      <p class="lede">From full home remodels to additions, ADUs, kitchens, bathrooms and custom builds, {business.shortName} helps San Jose homeowners create spaces that work for their lives.</p>
      <div class="hp-hero-actions">
        <a class="btn btn-gold" href="/request-estimate/" data-track="request_estimate_click">Request an Estimate</a>
        <a class="btn btn-outline-light" href="/projects/">View Our Projects</a>
      </div>
      <p class="hp-hero-area">Serving San Jose, California</p>
    </div>
  </section>

  <!-- 3 · TRUST STRIP (factual only: no badges, ratings or certifications) -->
  <section class="hp-trust" aria-label="About Gold Bay Builders">
    <div class="wrap hp-trust-row">
      <p><b>Remodels · Additions · ADUs · Kitchens &amp; bathrooms · Custom homes</b></p>
      <p>Serving San Jose, California · Owned by {business.owner}</p>
    </div>
  </section>

  <!-- 4 · HOMEOWNER PROBLEMS -->
  <section class="section hp-problems" aria-labelledby="prob-title">
    <div class="wrap hp-prob-wrap">
      <div class="hp-head">
        <span class="eyebrow">Common concerns</span>
        <h2 id="prob-title">Renovations go wrong in predictable ways.</h2>
      </div>
      <ul class="hp-problem-grid">
        {problems.map((p) => (
          <li class="hp-problem">
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ul>
      <p class="hp-problems-note">Common homeowner concerns, not guarantees. Ask for specifics in writing for your own project.</p>
    </div>
  </section>

  <!-- 5 · SERVICES -->
  <section class="section hp-services" aria-labelledby="svc-title">
    <div class="wrap">
      <div class="hp-head hp-center">
        <span class="eyebrow">What we build</span>
        <h2 id="svc-title">Five services for San Jose homes.</h2>
        <p>Choose the category that fits your project. Each service page explains the planning, permits and scope for that kind of work.</p>
      </div>
      <ul class="hp-svc-grid">
        {services.map((s) => (
          <li class:list={['hp-svc', s.key === 'cu' ? 'band' : 'compact']}>
            {s.key === 'kb' && (
              <div class="hp-svc-media" aria-hidden="true">
                {kitchenPhotos.map((im) => <ProjectImage file={im.file} alt="" focus={im.focus} aspect="4 / 3" mobileAspect="4 / 3" sizes="(min-width: 48rem) 22vw, 45vw" />)}
              </div>
            )}
            <div class="hp-svc-body">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <div class="hp-svc-links">
                {s.links.map((l) => <a class="arrow-link" href={l.href}>{l.label} <span aria-hidden="true">→</span></a>)}
              </div>
            </div>
          </li>
        ))}
      </ul>
      <div class="hp-services-foot">
        <a class="btn btn-primary" href="/services/">See all services</a>
        <a class="arrow-link" href="/request-estimate/">Not sure which one? Request an estimate <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 6 · RECENT PROJECTS -->
  <section class="section hp-work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="hp-work-head">
        <div>
          <span class="eyebrow">Our work</span>
          <h2 id="work-title">Recent projects</h2>
          <p>Kitchens, bathrooms and outdoor spaces, shown with the photographs we have for each project.</p>
        </div>
        <a class="btn btn-line" href="/projects/">View All Projects</a>
      </div>
      <ul class="hp-work-grid">
        {work.map((w) => (
          <li class="hp-proj">
            <a class="hp-proj-img" href={`/projects/${w.p.slug}/`} tabindex="-1" aria-hidden="true">
              <ProjectImage file={w.img.file} alt={w.img.alt} focus={w.focus} aspect="4 / 3" mobileAspect="4 / 3" sizes="(min-width: 48rem) 31vw, 100vw" />
            </a>
            <div class="hp-proj-body">
              <span class="hp-proj-cat">{w.p.category}</span>
              <h3>{w.p.title}</h3>
              <a class="arrow-link" href={`/projects/${w.p.slug}/`} aria-label={`View project: ${w.p.title}`}>View Project <span aria-hidden="true">→</span></a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 7 · FOUR-STEP PROCESS -->
  <section class="section sec-96 hp-process" aria-labelledby="proc-title">
    <div class="wrap">
      <div class="hp-head hp-center">
        <span class="eyebrow">How it works</span>
        <h2 id="proc-title">A clear process from first call to final walk-through.</h2>
      </div>
      <ol class="hp-steps">
        {steps.map((s, i) => (<li><span class="num">Step {i + 1}</span><h3>{s.t}</h3><p>{s.x}</p></li>))}
      </ol>
      <div class="hp-process-foot">
        <p>General guidance for homeowners. Timelines and sequence are set for each project in the estimate and agreement.</p>
        <a class="arrow-link" href="/our-process/">See our full process <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 8 · TESTIMONIALS -->
  <section class="section hp-reviews" aria-labelledby="proof-title">
    <div class="wrap">
      <div class="hp-head">
        <span class="eyebrow">What homeowners say</span>
        <h2 id="proof-title">Customer reviews, in their own words.</h2>
      </div>
      <div class="hp-review-grid">
        <div class="hp-review-main">
          <Testimonial review={lead} mode="excerpt" size="lg" />
        </div>
        <div class="hp-review-side">
          <div><Testimonial review={pairA} mode="excerpt" /></div>
          <div><Testimonial review={pairB} mode="excerpt" /></div>
        </div>
      </div>
      <p class="hp-reviews-foot"><a class="btn btn-line" href="/reviews/">View All Reviews</a></p>
    </div>
  </section>

  <!-- 9 · SERVICE AREAS -->
  <section class="section sec-96 hp-area" aria-labelledby="area-title">
    <div class="wrap hp-area-grid hp-center">
      <div>
        <span class="eyebrow">Service area</span>
        <h2 id="area-title">Based in San Jose, California.</h2>
        <p>San Jose is our home market. Permit rules, ADU requirements and review times are set city by city, so each project is planned around the jurisdiction it sits in.</p>
      </div>
      <div class="hp-area-links">
        <a class="hp-area-chip" href="/service-areas/san-jose/">San Jose</a>
        <a class="hp-area-chip" href="/service-areas/">All service areas</a>
      </div>
    </div>
  </section>

  <!-- 10 · FINAL CTA -->
  <section class="section sec-128 hp-cta on-dark" aria-labelledby="cta-title">
    <div class="wrap hp-cta-grid hp-center">
      <div>
        <span class="eyebrow">Get started</span>
        <h2 id="cta-title">Ready to get your project started?</h2>
        <p>Tell us about your home and what you want to change. We will follow up to talk through scope and next steps.</p>
      </div>
      <div>
        <div class="hp-cta-btns">
          <a class="btn btn-gold" href="/request-estimate/" data-track="request_estimate_click">Request an Estimate</a>
          <a class="btn btn-outline-light" href={business.phoneHref} data-track="click_to_call">Call Now</a>
        </div>
        <p class="hp-cta-note">Estimate requests take about two minutes. Prefer email? <a href={`mailto:${business.email}`} data-track="email_us" style="color:var(--color-white);text-decoration:underline">Email Us</a>.</p>
      </div>
    </div>
  </section>
</Base>
