---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ProjectImage from '../components/ProjectImage.astro';
import Testimonial from '../components/Testimonial.astro';
import { business } from '../data/business';
import { generalFaqs } from '../data/faqs';
import { serviceTiles, homeFaqKeys, heroPhoto, contractorChecks } from '../data/home';
import { getProject } from '../data/projects';
import { getReview } from '../data/reviews';

const faqs = homeFaqKeys.map((q) => generalFaqs.find((f) => f.q === q)!).filter(Boolean);
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const hero = getProject(heroPhoto.slug).images[heroPhoto.i];

// Homeowner problems: framed as what to watch for, with a practical question to ask. No guarantees.
const problems = [
  { title: 'Unclear scope', text: 'Projects drift when the scope is only discussed, not written down.', ask: 'Ask for a written scope that lists what is included and what is not.' },
  { title: 'Budget surprises', text: 'Costs climb when allowances are vague and changes are priced later.', ask: 'Ask how changes are priced and approved before the work happens.' },
  { title: 'Poor communication', text: 'Long silences between visits leave homeowners guessing what happens next.', ask: 'Ask who your contact is and how often you will get updates.' },
  { title: 'Messy job sites', text: 'Dust and debris spread through a home when the work area is not contained.', ask: 'Ask how the work area is protected and left at the end of each day.' },
];

// Services: short, factual, each linked to its page.
const services = serviceTiles.map((t) => ({ title: t.title, text: t.text, scope: t.scope, href: t.links[0].href, label: t.links[0].label, extra: t.links.slice(1) }));

// Projects: three real photographs, no bathroom repeated.
const work = [
  { slug: 'kitchen-remodel', focus: '50% 52%' },
  { slug: 'bathroom-stone-shower-terracotta-floor', focus: '50% 45%' },
  { slug: 'patio-construction', focus: '50% 68%' },
].map((f) => { const p = getProject(f.slug); return { ...f, p, img: p.images[0] }; });

// Reviews: exact supplied text.
const lead = getReview('terri-m');
const pairA = getReview('andrea-j');
const pairB = getReview('kevin-j');

// Four homeowner steps: general guidance, not confirmed timelines.
const steps = [
  { t: 'Tell us about the project', x: 'Share what you want to change, the property and a budget range.' },
  { t: 'Site review and scope', x: 'We look at the property and write down what is and is not included.' },
  { t: 'Estimate and agreement', x: 'You receive a written estimate to compare, and terms are settled before work begins.' },
  { t: 'Planning, build and closeout', x: 'Selections, permits, construction and a final walk-through, with decisions raised before they delay work.' },
];
---
<Base
  title="Gold Bay Builders | Home Remodeling & Construction in San Jose, CA"
  description="Gold Bay Builders is a San Jose residential contractor for full home remodels, additions, ADUs, kitchen and bathroom remodeling and custom builds. Request an estimate."
  path="/"
  overlayHeader
  schema={[faqSchema]}
>
  <!-- 1 · HERO -->
  <section class="hp-hero on-dark" aria-labelledby="hero-title">
    <div class="hp-hero-bg">
      <ProjectImage file={hero.file} alt="" focus={hero.focus} aspect="4 / 5" mobileAspect="4 / 5" mobileFocus="60% 56%" sizes="100vw" priority />
    </div>
    <div class="wrap hp-hero-inner">
      <span class="eyebrow">San Jose home remodeling &amp; construction</span>
      <h1 id="hero-title">Built for the way you live.</h1>
      <p class="lede">From full home remodels to additions, ADUs, kitchens, bathrooms and custom builds, {business.shortName} helps San Jose homeowners create spaces that work for their lives.</p>
      <div class="hp-hero-actions">
        <a class="btn btn-gold" href="/request-estimate/" data-track="request_estimate_click">Request an Estimate</a>
        <a class="btn btn-outline-light" href="/projects/">View Our Projects</a>
      </div>
      <p class="hp-hero-area">Serving San Jose, California</p>
    </div>
  </section>

  <!-- 2 · TRUST + INTRODUCTION -->
  <section class="hp-trust" aria-label="At a glance">
    <div class="wrap">
      <ul class="hp-trust-list">
        <li><div><strong>Five residential services</strong><span>Remodels, additions, ADUs, kitchens and bathrooms, and custom homes.</span></div></li>
        <li><div><strong>Built for San Jose homes</strong><span>Planned around city permit rules, ADU requirements and the house you already have.</span></div></li>
        <li><div><strong>Owned by David Lerma</strong><span>Gold Bay Builders Inc. is a San Jose residential construction company.</span></div></li>
      </ul>
    </div>
  </section>

  <section class="section hp-intro" aria-labelledby="intro-title">
    <div class="wrap hp-intro-grid">
      <div>
        <span class="eyebrow">Who we are</span>
        <h2 id="intro-title">Gold Bay Builders is a residential construction company serving San Jose homeowners.</h2>
        <p>Projects range from a single kitchen or bathroom to a whole-house remodel, a backyard ADU or a ground-up build. Each one begins with how you live in the house, what the property allows and what you want to spend.</p>
        <p style="margin-top:1.5rem"><a class="arrow-link" href="/about/">About Gold Bay Builders <span aria-hidden="true">→</span></a></p>
      </div>
      <div class="hp-intro-facts">
        <div class="hp-fact"><b>Remodels, additions and new homes</b><span>Five service categories, from kitchens and bathrooms to custom builds.</span></div>
        <div class="hp-fact"><b>Questions homeowners should ask</b><span>Six practical questions to ask any contractor, including us, are below.</span></div>
        <div class="hp-fact"><b>Real projects, real photos</b><span>Our project pages show the photographs we have from completed work.</span></div>
      </div>
    </div>
  </section>

  <!-- 3 · HOMEOWNER PROBLEMS -->
  <section class="section hp-problems" aria-labelledby="prob-title">
    <div class="wrap">
      <div class="hp-head">
        <span class="eyebrow">Common concerns</span>
        <h2 id="prob-title">Renovations go wrong in predictable ways.</h2>
        <p>Most homeowner frustrations come from four places. Each one is easier to avoid when the right questions are asked before work starts.</p>
      </div>
      <ul class="hp-problem-grid">
        {problems.map((p) => (
          <li class="hp-problem">
            <h3>{p.title}</h3>
            <p>{p.text}</p>
            <p class="ask">{p.ask}</p>
          </li>
        ))}
      </ul>
      <p class="hp-problems-note">These are common homeowner concerns, not guarantees. Ask for specifics in writing for your own project.</p>
    </div>
  </section>

  <!-- 4 · SERVICES -->
  <section class="section hp-services" aria-labelledby="svc-title">
    <div class="wrap">
      <div class="hp-head">
        <span class="eyebrow">What we build</span>
        <h2 id="svc-title">Five services for San Jose homes.</h2>
        <p>Choose the category that fits your project. Each service page explains the planning, permits and scope for that kind of work.</p>
      </div>
      <ul class="hp-svc-grid">
        {services.map((s, i) => (
          <li class:list={['hp-svc', i >= 3 && 'wide']}>
            {i === 3 && (
              <div class="hp-svc-media" aria-hidden="true">
                {['kitchen-remodel', 'bathroom-stone-shower-terracotta-floor'].map((slug) => { const im = getProject(slug).images[0]; return <ProjectImage file={im.file} alt="" focus={im.focus} aspect="4 / 3" mobileAspect="4 / 3" sizes="(min-width: 64rem) 24vw, 45vw" />; })}
              </div>
            )}
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <ul class="hp-svc-scope">{s.scope.map((x) => <li>{x}</li>)}</ul>
            <div class="hp-svc-links">
              <a class="arrow-link" href={s.href}>{s.label} <span aria-hidden="true">→</span></a>
              {s.extra.map((l) => <a class="arrow-link" href={l.href}>{l.label} <span aria-hidden="true">→</span></a>)}
            </div>
          </li>
        ))}
      </ul>
      <div class="hp-services-foot">
        <a class="btn btn-primary" href="/services/">See all services</a>
        <a class="arrow-link" href="/request-estimate/">Not sure which one? Request an estimate <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 5 · RECENT PROJECTS -->
  <section class="section hp-work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="hp-work-head">
        <div>
          <span class="eyebrow">Our work</span>
          <h2 id="work-title">Recent projects</h2>
          <p>Kitchens, bathrooms and outdoor spaces, shown with the photographs we have for each project.</p>
        </div>
        <a class="btn btn-line" href="/projects/">View All Projects</a>
      </div>
      <ul class="hp-work-grid">
        {work.map((w) => (
          <li class="hp-proj">
            <a class="hp-proj-img" href={`/projects/${w.p.slug}/`} tabindex="-1" aria-hidden="true">
              <ProjectImage file={w.img.file} alt={w.img.alt} focus={w.focus} aspect="4 / 3" mobileAspect="4 / 3" sizes="(min-width: 48rem) 31vw, 100vw" />
            </a>
            <div class="hp-proj-body">
              <span class="hp-proj-cat">{w.p.category}</span>
              <h3>{w.p.title}</h3>
              <a class="arrow-link" href={`/projects/${w.p.slug}/`} aria-label={`View project: ${w.p.title}`}>View Project <span aria-hidden="true">→</span></a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 6 · HOW IT WORKS -->
  <section class="section hp-process" aria-labelledby="proc-title">
    <div class="wrap">
      <div class="hp-head">
        <span class="eyebrow">How it works</span>
        <h2 id="proc-title">A clear process from first call to final walk-through.</h2>
      </div>
      <ol class="hp-steps">
        {steps.map((s, i) => (<li><span class="num">Step {i + 1}</span><h3>{s.t}</h3><p>{s.x}</p></li>))}
      </ol>
      <div class="hp-process-foot">
        <p>General guidance for homeowners. Timelines and sequence are set for each project in the estimate and agreement.</p>
        <a class="arrow-link" href="/our-process/">See our full process <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 7 · REVIEWS -->
  <section class="section hp-reviews" aria-labelledby="proof-title">
    <div class="wrap">
      <div class="hp-head">
        <span class="eyebrow">What homeowners say</span>
        <h2 id="proof-title">Customer reviews, in their own words.</h2>
      </div>
      <div class="hp-review-grid">
        <div class="hp-review-main">
          <Testimonial review={lead} mode="excerpt" size="lg" />
        </div>
        <div class="hp-review-side">
          <div><Testimonial review={pairA} /></div>
          <div><Testimonial review={pairB} mode="excerpt" /></div>
        </div>
      </div>
      <p class="hp-reviews-foot"><a class="btn btn-line" href="/reviews/">View All Reviews</a></p>
    </div>
  </section>

  <!-- 8 · SERVICE AREA -->
  <section class="section hp-area" aria-labelledby="area-title">
    <div class="wrap hp-area-grid">
      <div>
        <span class="eyebrow">Service area</span>
        <h2 id="area-title">Based in San Jose, California.</h2>
        <p>San Jose is our home market. Permit rules, ADU requirements and review times are set city by city, so each project is planned around the jurisdiction it sits in.</p>
      </div>
      <div class="hp-area-links">
        <a class="hp-area-chip" href="/service-areas/san-jose/">San Jose</a>
        <a class="hp-area-chip" href="/service-areas/">All service areas</a>
      </div>
    </div>
  </section>

  <!-- 8b · QUESTIONS TO ASK A CONTRACTOR -->
  <section class="section hp-ask" aria-labelledby="ask-title">
    <div class="wrap hp-ask-grid">
      <div>
        <span class="eyebrow">Choosing a contractor</span>
        <h2 id="ask-title">Six questions worth asking any contractor.</h2>
        <p>Communication, cost changes and unclear scope cause most homeowner frustration. These questions apply to us as much as to anyone you interview.</p>
        <p class="hp-ask-note">Always check a license, bond and workers’ compensation on the <a class="arrow-link" href={business.license.cslbUrl} rel="noopener">CSLB license lookup</a>.</p>
      </div>
      <div class="hp-acc">
        {contractorChecks.map((c) => (
          <details class="hp-acc-item" name="ask">
            <summary><span>{c.topic}</span><span class="hp-acc-icon" aria-hidden="true"></span></summary>
            <div class="hp-acc-body">
              <p class="hp-acc-q">{c.ask}</p>
              <p>{c.good}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 9 · FAQ -->
  <section class="section hp-faq" aria-labelledby="faq-title">
    <div class="wrap hp-faq-grid">
      <div>
        <span class="eyebrow">Common questions</span>
        <h2 id="faq-title">Before you call.</h2>
        <p class="lede" style="margin-top:1.25rem;font-size:1rem">Short answers to what homeowners ask first. For more depth, start with the guides.</p>
        <ul class="hp-faq-links">
          <li><a class="arrow-link" href="/guides/san-jose-adu-guide/">San Jose ADU guide <span aria-hidden="true">→</span></a></li>
          <li><a class="arrow-link" href="/guides/bay-area-remodeling-budget/">Remodeling budget guide <span aria-hidden="true">→</span></a></li>
          <li><a class="arrow-link" href="/faq/">All questions <span aria-hidden="true">→</span></a></li>
        </ul>
      </div>
      <div><Faq items={faqs} /></div>
    </div>
  </section>

  <!-- 10 · FINAL CTA -->
  <section class="section hp-cta on-dark" aria-labelledby="cta-title">
    <div class="wrap hp-cta-grid">
      <div>
        <span class="eyebrow">Get started</span>
        <h2 id="cta-title">Ready to get your project started?</h2>
        <p>Tell us about your home and what you want to change. We will follow up to talk through scope and next steps.</p>
      </div>
      <div>
        <div class="hp-cta-btns">
          <a class="btn btn-gold" href="/request-estimate/" data-track="request_estimate_click">Request an Estimate</a>
          <a class="btn btn-outline-light" href={business.phoneHref} data-track="click_to_call">Call Now</a>
        </div>
        <p class="hp-cta-note">Estimate requests take about two minutes. Prefer email? <a href={`mailto:${business.email}`} data-track="email_us" style="color:var(--color-white);text-decoration:underline">Email Us</a>.</p>
      </div>
    </div>
  </section>
</Base>
