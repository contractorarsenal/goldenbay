---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import ElevationArt from '../components/ElevationArt.astro';
import Placeholder from '../components/Placeholder.astro';
import { services } from '../data/services';
import { processSteps } from '../data/process';
import { generalFaqs } from '../data/faqs';
import { business } from '../data/business';

const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: generalFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base title="Golden Bay Builders | Home Remodeling, ADUs & Additions in San Jose, CA" description="Golden Bay Builders is a San Jose residential contractor for full home remodeling, additions, ADUs, kitchens, bathrooms and custom homes. Request an estimate." path="/" schema={[faqSchema]}>
  <section class="hero on-dark blueprint">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">Residential construction · San Jose, CA</span>
        <h1>Building better homes <em>across San Jose.</em></h1>
        <p class="lede">Full home remodeling, additions, ADUs, kitchens and bathrooms, planned and built with clear communication from the first conversation to final inspection.</p>
        <div class="hero-actions">
          <a class="btn btn-brass" href="/request-estimate/" data-track="request_estimate_click">Request an estimate</a>
          <a class="btn btn-line" href="/projects/">View projects</a>
        </div>
        <div class="hero-facts">
          <div><strong>{business.owner}</strong>Owner</div>
          <div><strong>6 services</strong>Remodels to new homes</div>
          <div><strong>San Jose</strong>Home market</div>
        </div>
      </div>
      <ElevationArt />
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="reveal"><span class="eyebrow">Who we are</span><h2 style="margin-top:1.25rem">A San Jose builder for homeowners who want it done properly.</h2></div>
      <div class="prose reveal">
        <p class="lede">{business.name} is a residential general contractor led by owner {business.owner}. We build remodels, additions, accessory dwelling units and custom homes in San Jose.</p>
        <p>Every project begins with a conversation about how you live in the house, what the property allows and what you want to spend. From there we define scope in writing, so you know what is included before work starts.</p>
        <p><a class="arrow-link" href="/about/">About Golden Bay Builders <span aria-hidden="true">→</span></a></p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="reveal" style="margin-bottom:3rem"><span class="eyebrow">What we build</span><h2 style="margin-top:1.25rem;max-width:20ch">Six services, one accountable builder.</h2></div>
      <div>
        {services.map((s) => (
          <a class="svc-row reveal" href={`/services/${s.slug}/`}>
            <span class="num">{s.num}</span><h3>{s.name}</h3><p>{s.short}</p><span class="go" aria-hidden="true">→</span>
          </a>
        ))}
        <div style="border-top:1px solid var(--color-stone-2)"></div>
      </div>
    </div>
  </section>

  <section class="section bg-stone">
    <div class="wrap">
      <div class="split rev">
        <div class="reveal">
          <span class="eyebrow">Projects</span><h2 style="margin:1.25rem 0 1.5rem">Our work, documented properly.</h2>
          <p class="lede">Completed-project case studies are being prepared with approved photography and scope details. We only show real work.</p>
          <p style="margin-top:1.5rem"><a class="arrow-link" href="/projects/">Projects <span aria-hidden="true">→</span></a></p>
        </div>
        <div style="display:grid;grid-template-columns:1.4fr 1fr;gap:1rem" class="reveal">
          <Placeholder label="Featured project" ratio="4 / 5" /><div style="display:grid;gap:1rem"><Placeholder label="Detail" ratio="1 / 1" /><Placeholder label="Interior" ratio="1 / 1" /></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="reveal"><span class="eyebrow">Meet the owner</span><h2 style="margin-top:1.25rem">{business.owner}</h2></div>
      <div class="prose reveal">
        <p class="lede">David Lerma owns Golden Bay Builders and is your point of contact for the project.</p>
        <p>You work directly with the person accountable for the job. A fuller biography, covering David’s background and how he came to construction, will appear here once he has reviewed it.</p>
        <p><a class="arrow-link" href="/about/">About the company <span aria-hidden="true">→</span></a></p>
      </div>
    </div>
  </section>

  <section class="section bg-ink on-dark">
    <div class="wrap">
      <div class="reveal" style="margin-bottom:3rem"><span class="eyebrow">What to expect</span><h2 style="margin-top:1.25rem;max-width:18ch">Clear expectations from the first call.</h2></div>
      <ul class="rule-list">
        {[
          ['Scope in writing', 'You know what is included, what is not, and how changes are handled before work begins.'],
          ['Planning before demolition', 'Selections, permits and long-lead orders are organized so the work is not waiting on decisions.'],
          ['Direct communication', 'You deal with the owner, not a call center. Questions get answered by someone who knows the job.'],
          ['Workmanship you can inspect', 'Work is staged so key layers are reviewed and inspected before they are covered.'],
        ].map(([t, d], i) => <li class="reveal"><span class="num">0{i + 1}</span><h3>{t}</h3><p>{d}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="split">
        <div class="reveal"><span class="eyebrow">How it works</span><h2 style="margin-top:1.25rem">From first conversation to final walkthrough.</h2><p style="margin-top:1.5rem"><a class="arrow-link" href="/our-process/">Our full process <span aria-hidden="true">→</span></a></p></div>
        <ol class="rule-list" style="list-style:none">
          {processSteps.map((p) => <li class="reveal" style="grid-template-columns:3rem 1fr"><span class="num">{p.n}</span><div><h3 style="font-size:1.35rem">{p.title}</h3><p style="color:var(--color-muted);margin-top:.25rem">{p.text}</p></div></li>)}
        </ol>
      </div>
    </div>
  </section>

  <section class="section bg-ink on-dark">
    <div class="wrap">
      <div class="reveal" style="margin-bottom:3rem;display:grid;gap:1rem"><span class="eyebrow">Before you hire anyone</span><h2 style="max-width:20ch">Straight answers to the questions that decide a project.</h2></div>
      <div style="display:grid;gap:1px;background:rgb(255 255 255 / .18);border:1px solid rgb(255 255 255 / .18)" class="tiles three reveal">
        <a class="guide-card" style="background:var(--color-ink)" href="/guides/san-jose-adu-guide/"><span class="num">Guide</span><h3 style="margin:.5rem 0">Can I build an ADU on my San Jose lot?</h3><p style="color:#cfc8bb">Detached, attached and garage conversions, state rules, impact fees and the permit steps, with sources.</p><p style="margin-top:1rem;color:var(--color-brass)">Read the ADU guide →</p></a>
        <a class="guide-card" style="background:var(--color-ink)" href="/guides/bay-area-remodeling-budget/"><span class="num">Guide</span><h3 style="margin:.5rem 0">What actually drives remodeling cost?</h3><p style="color:#cfc8bb">Scope, layout changes, home age and selections, plus costs outside the construction contract.</p><p style="margin-top:1rem;color:var(--color-brass)">Read the budget guide →</p></a>
        <a class="guide-card" style="background:var(--color-ink)" href="/our-process/"><span class="num">Process</span><h3 style="margin:.5rem 0">What happens after I call?</h3><p style="color:#cfc8bb">Six stages from the first conversation to the final walkthrough, and where decisions fall on your side.</p><p style="margin-top:1rem;color:var(--color-brass)">See the process →</p></a>
      </div>
    </div>
  </section>

  <section class="section bg-stone">
    <div class="wrap split">
      <div class="reveal"><span class="eyebrow">Reviews</span><h2 style="margin-top:1.25rem">What homeowners say</h2></div>
      <div class="prose reveal"><p class="lede">Client reviews will be published here with each homeowner’s permission, attributed accurately. We do not publish anonymous or invented testimonials.</p></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="reveal"><span class="eyebrow">Service area</span><h2 style="margin-top:1.25rem">Based in San Jose.</h2></div>
      <div class="prose reveal">
        <p class="lede">San Jose is our home market. Building rules, ADU requirements and permit processes are set city by city, so we plan every project around the jurisdiction it sits in.</p>
        <p><a class="arrow-link" href="/service-areas/san-jose/">Remodeling and building in San Jose <span aria-hidden="true">→</span></a></p>
        <p style="font-size:.95rem;color:var(--color-muted)">Outside San Jose? <a href="/contact/">Ask us</a>. We are confirming nearby cities.</p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap split">
      <div class="reveal"><span class="eyebrow">Questions</span><h2 style="margin-top:1.25rem">Common questions</h2><p style="margin-top:1.5rem"><a class="arrow-link" href="/faq/">All FAQs <span aria-hidden="true">→</span></a></p></div>
      <div class="reveal"><Faq items={generalFaqs} /></div>
    </div>
  </section>

  <Cta />
</Base>
