---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Cta from '../components/Cta.astro';
import ProjectImage from '../components/ProjectImage.astro';
import { business } from '../data/business';
import { getProject } from '../data/projects';

// Photographs of real Gold Bay work. Each one links to its project page.
const hero = getProject('kitchen-remodel').images[0];
const company = getProject('bathroom-stone-shower-terracotta-floor').images[0];
const work = ['kitchen-remodel', 'bathroom-stone-shower-terracotta-floor', 'patio-construction'].map((slug) => {
  const p = getProject(slug);
  return { p, img: p.images[0] };
});
---
<Base closingCta title="About Gold Bay Builders" description="Gold Bay Builders Inc. is a residential construction company serving San Jose, led by owner David Lerma." path="/about/" crumbs={[{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }]}>
  <!-- A: introduction -->
  <section class="ab-intro" aria-labelledby="about-title">
    <div class="wrap">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'About' }]} />
      <div class="ab-intro-grid">
      <div>
        <h1 id="about-title">Built Around Your Home.</h1>
        <p class="lede ab-lede">Gold Bay Builders Inc. is a residential construction company serving San Jose, California.</p>
      </div>
      <figure class="ab-intro-photo">
        <ProjectImage file={hero.file} alt={hero.alt} focus={hero.focus} aspect="1 / 1" mobileAspect="4 / 3" sizes="(min-width: 60rem) 45vw, 100vw" priority />
      </figure>
      </div>
    </div>
  </section>

  <!-- B: the company -->
  <section class="ab-sec" aria-labelledby="company-title">
    <div class="wrap ab-company">
      <div>
        <span class="eyebrow">The company</span>
        <h2 id="company-title" class="ab-h2">What we build</h2>
        <p class="ab-body">Full home remodels, additions, accessory dwelling units, kitchens, bathrooms and custom homes. Recent work includes kitchen and bathroom remodels, patios and pavers, and an outdoor living area around a pool house.</p>
        <p class="ab-body ab-links"><a class="v8-link" href="/services/">Browse our services <span aria-hidden="true">→</span></a></p>
      </div>
      <figure class="ab-company-photo">
        <ProjectImage file={company.file} alt={company.alt} focus={company.focus} aspect="4 / 3" mobileAspect="4 / 3" sizes="(min-width: 60rem) 45vw, 100vw" />
      </figure>
    </div>
  </section>

  <!-- C: the owner (one introduction only) -->
  <section class="ab-sec" aria-labelledby="owner-title">
    <div class="wrap ab-owner">
      <div class="ab-owner-type" aria-hidden="true">
        <span class="ab-owner-name">Owner</span>
        <span class="ab-owner-role">{business.name}<br />San Jose, California</span>
      </div>
      <div>
        <h2 id="owner-title" class="ab-h2">Meet David Lerma</h2>
        <p class="ab-body">David owns Gold Bay Builders Inc. and is the main point of contact for homeowners who call or write about a project.</p>
        <p class="ab-body">Homeowners can speak with David directly by phone, or send an estimate request and ask for him.</p>
        <div class="ab-actions">
          <a class="btn btn-primary" href={business.phoneHref} data-track="click_to_call">Call Now</a>
          <a class="btn btn-line" href="/request-estimate/" data-track="request_estimate_click">Request an Estimate</a>
        </div>
      </div>
    </div>
  </section>

  <!-- D: see the work -->
  <section class="ab-sec" aria-labelledby="work-title">
    <div class="wrap">
      <div class="ab-work-head">
        <div>
          <span class="eyebrow">Our work</span>
          <h2 id="work-title" class="ab-h2">See the work</h2>
        </div>
        <a class="v8-link" href="/projects/">Our Projects <span aria-hidden="true">→</span></a>
      </div>
      <ul class="ab-work">
        {work.map((w) => (
          <li>
            <a class="ab-work-img" href={`/projects/${w.p.slug}/`} tabindex="-1" aria-hidden="true">
              <ProjectImage file={w.img.file} alt={w.img.alt} focus={w.img.focus} aspect="4 / 3" mobileAspect="4 / 3" sizes="(min-width: 48rem) 31vw, 100vw" />
            </a>
            <h3><a href={`/projects/${w.p.slug}/`}>{w.p.title}</a></h3>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- E: one closing CTA -->
  <Cta title="Start a conversation about your home." text="Tell us about the project, or call and ask for David." />
</Base>
