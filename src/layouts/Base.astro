---
import '../styles/global.css';
import '../styles/system.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { business, abs } from '../data/business';
import { organizationSchema, breadcrumbSchema, webPageSchema } from '../lib/schema';

interface Props {
  title: string; description: string; path: string;
  /** Page is awaiting verified content: noindex and excluded from the sitemap. */
  noindex?: boolean;
  crumbs?: { name: string; path: string }[];
  schema?: object[];
  ogType?: 'website' | 'article';
  /** Transparent header over a dark hero that turns solid on scroll. */
  overlayHeader?: boolean;
}
const { title, description, path, noindex = false, crumbs, schema = [], ogType = 'website', overlayHeader = false } = Astro.props;
const fullTitle = path === '/' ? title : `${title} | ${business.shortName}`;
const robots = !business.indexable || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const graph = [
  organizationSchema(),
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': abs('/#website'), url: abs('/'), name: business.name, publisher: { '@id': abs('/#organization') } },
  webPageSchema(fullTitle, path, description),
  ...(crumbs ? [breadcrumbSchema(crumbs)] : []),
  ...schema,
];
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={abs(path)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1d1c1a" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(path)} />
    <meta property="og:image" content={abs('/og-default.svg')} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <Analytics />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header path={path} overlay={overlayHeader} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <nav class="callbar" aria-label="Quick contact">
      <a href={business.phoneHref} data-track="click_to_call">Call Now</a>
      <a href="/request-estimate/" data-track="request_estimate_click">Request an Estimate</a>
    </nav>
    <script>
      // Menu, dropdown, header state, reveal-on-scroll and non-PII event tracking.
      const hdr = document.querySelector<HTMLElement>('.site-header[data-overlay]');
      if (hdr) { const upd = () => hdr.classList.toggle('solid', window.scrollY > 24); upd(); addEventListener('scroll', upd, { passive: true }); }
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const panel = document.getElementById('mobile-panel');
      toggle?.addEventListener('click', () => {
        const open = panel!.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(open));
        toggle.textContent = open ? 'Close' : 'Menu';
        document.body.style.overflow = open ? 'hidden' : '';
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        if (panel?.classList.contains('open')) { toggle?.click(); toggle?.focus(); }
        document.querySelectorAll('.has-dd.open').forEach((el) => { el.classList.remove('open'); el.querySelector('button')?.setAttribute('aria-expanded', 'false'); });
      });
      document.querySelectorAll<HTMLElement>('.has-dd').forEach((dd) => {
        const b = dd.querySelector('button')!;
        b.addEventListener('click', () => { const o = dd.classList.toggle('open'); b.setAttribute('aria-expanded', String(o)); });
        dd.addEventListener('focusout', (e) => { if (!dd.contains((e as FocusEvent).relatedTarget as Node)) { dd.classList.remove('open'); b.setAttribute('aria-expanded', 'false'); } });
      });
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      } else document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in'));
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-track]');
        if (!el) return;
        const w = window as any; const ev = el.dataset.track!;
        (w.dataLayer = w.dataLayer || []).push({ event: ev });
      });
    </script>
  </body>
</html>
