---
// Original architectural line drawings, used as clearly-captioned illustrations. They are NOT Golden Bay Builders projects.
const { kind, caption } = Astro.props as { kind: 'remodel' | 'addition' | 'adu' | 'kitchen' | 'bath' | 'custom'; caption?: string };
const labels: Record<string, string> = { remodel: 'Floor plan: walls reworked', addition: 'Elevation: new volume dashed', adu: 'Site plan: house and ADU', kitchen: 'Kitchen plan: work triangle', bath: 'Bathroom plan', custom: 'Site plan: foundation layout' };
---
<figure class="plate">
  <svg viewBox="0 0 560 420" role="img" aria-label={`Line illustration: ${labels[kind]}`} fill="none" stroke="#c19a55" stroke-width="1.5" stroke-linecap="square">
    {kind === 'remodel' && <g>
      <rect x="60" y="60" width="440" height="280" /><path d="M60 200H220M300 200H500M280 60V140M280 200V340M160 200V340" />
      <path d="M220 200L300 200" stroke-dasharray="6 6" stroke-opacity=".7" /><path d="M280 140V200" stroke-dasharray="6 6" stroke-opacity=".7" />
      <path d="M100 60V50M200 60V50M380 60V50" stroke-opacity=".5" /><path d="M60 372H500M60 366V378M500 366V378" stroke-opacity=".4" />
      <path d="M320 200a30 30 0 0 1 30 30" stroke-opacity=".6" /><path d="M160 300a30 30 0 0 0 30 30" stroke-opacity=".6" />
    </g>}
    {kind === 'addition' && <g>
      <path d="M40 350H520" /><path d="M70 350V210L180 130L290 210V350" /><path d="M58 216L180 120L302 216" />
      <rect x="110" y="250" width="44" height="60" /><rect x="206" y="250" width="44" height="60" />
      <g stroke-dasharray="7 6"><path d="M290 350V240H460V350" /><path d="M290 240L375 190L460 240" /><rect x="330" y="270" width="60" height="50" /></g>
      <path d="M290 210V240" stroke-opacity=".5" /><path d="M40 370H520" stroke-opacity=".3" />
    </g>}
    {kind === 'adu' && <g>
      <rect x="40" y="40" width="480" height="340" stroke-opacity=".5" /><rect x="90" y="70" width="190" height="110" /><path d="M90 125H280M185 70V180" stroke-opacity=".4" />
      <rect x="320" y="250" width="150" height="90" stroke-dasharray="7 6" /><path d="M385 250V340M320 295H470" stroke-opacity=".4" stroke-dasharray="3 5" />
      <path d="M185 180V215H395V250" stroke-opacity=".7" stroke-dasharray="2 6" /><path d="M40 380H520" /><path d="M280 380V215" stroke-opacity=".35" />
      <circle cx="395" cy="215" r="3" /><path d="M60 360V300H120V360" stroke-opacity=".5" />
    </g>}
    {kind === 'kitchen' && <g>
      <rect x="60" y="60" width="440" height="300" /><path d="M60 110H500M60 110V360M60 160H110M60 160V330" stroke-opacity=".0" />
      <path d="M60 60V360M60 60H500" stroke-width="2" /><rect x="60" y="60" width="440" height="36" /><rect x="60" y="96" width="36" height="200" />
      <rect x="190" y="200" width="200" height="70" /><circle cx="210" cy="82" r="10" /><rect x="280" y="68" width="60" height="22" />
      <path d="M215 85L110 200L290 235Z" stroke-opacity=".45" stroke-dasharray="5 6" /><path d="M500 250V300" stroke-width="4" stroke-opacity=".4" />
    </g>}
    {kind === 'bath' && <g>
      <rect x="80" y="60" width="400" height="280" /><rect x="80" y="60" width="200" height="90" /><path d="M280 60V150H80" stroke-opacity=".0" />
      <rect x="320" y="60" width="130" height="50" /><circle cx="385" cy="85" r="14" /><rect x="360" y="250" width="70" height="30" rx="14" /><rect x="395" y="285" width="40" height="30" />
      <path d="M80 250H170a40 40 0 0 1 40 40" stroke-opacity=".6" /><path d="M80 340V250" /><path d="M280 150H80" />
    </g>}
    {kind === 'custom' && <g>
      <path d="M40 60H520M40 140H520M40 220H520M40 300H520M120 40V380M240 40V380M360 40V380M480 40V380" stroke-opacity=".18" />
      <path d="M120 140H360V300H120Z" /><path d="M360 140H480V220H360" stroke-opacity=".7" /><path d="M160 180H320V260H160Z" stroke-opacity=".5" />
      <path d="M60 340H300" stroke-dasharray="7 6" stroke-opacity=".7" /><circle cx="120" cy="140" r="4" /><circle cx="360" cy="140" r="4" /><circle cx="120" cy="300" r="4" /><circle cx="360" cy="300" r="4" />
      <path d="M40 40H80M40 40V80" />
    </g>}
  </svg>
  <figcaption>{caption ?? labels[kind]} · illustrative diagram, not a project</figcaption>
</figure>
