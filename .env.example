# Production domain (no trailing slash). Required for canonicals, sitemap, schema.
PUBLIC_SITE_URL=
# Set to "true" ONLY at launch. Anything else emits noindex on every page.
PUBLIC_ALLOW_INDEXING=false
# Analytics (all optional; nothing loads until set)
PUBLIC_GA4_ID=
PUBLIC_GTM_ID=
PUBLIC_CLARITY_ID=
# Forms (contact and estimate) submit to Web3Forms from the browser. The public access key is in
# src/lib/web3forms.ts, not here. The receiving inbox is set in the Web3Forms dashboard.
# There are no server-side secrets: the site has no server functions.
