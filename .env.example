# Production domain (no trailing slash). Required for canonicals, sitemap, schema.
PUBLIC_SITE_URL=
# Set to "true" ONLY at launch. Anything else emits noindex on every page.
PUBLIC_ALLOW_INDEXING=false
# Analytics (all optional; nothing loads until set)
PUBLIC_GA4_ID=
PUBLIC_GTM_ID=
PUBLIC_CLARITY_ID=
# Cloudflare Turnstile (public site key)
PUBLIC_TURNSTILE_SITE_KEY=
# --- Server-side only (Cloudflare Pages secrets, never PUBLIC_) ---
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=
