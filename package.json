{
  "name": "goldenbay",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "verify": "PUBLIC_SITE_URL=https://example.com PUBLIC_ALLOW_INDEXING=true astro build && node scripts/verify-site.mjs",
    "preview:cf": "npm run build && wrangler pages deploy dist --project-name goldbay --branch preview",
    "verify:preview": "node scripts/verify-preview.mjs",
    "preview:branch": "node scripts/publish-preview-branch.mjs",
    "verify:remote": "node scripts/verify-remote.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
